# ---------------------------------------------------------------------------
# API gateway (public HTTP surface)
# ---------------------------------------------------------------------------
PORT=4000

# Shared secret the Next.js server presents to POST /auth/token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEY=replace-me-with-a-random-32-byte-hex-string

# Signing key for the gateway-issued JWTs. Must also be at least 32 bytes.
JWT_SECRET=replace-me-with-a-different-random-32-byte-hex-string
JWT_ISSUER=zurich-portal-gateway
JWT_AUDIENCE=zurich-portal
JWT_TTL_SECONDS=900

# Comma-separated browser origins allowed to call the gateway directly.
# Leave empty: the portal calls this API from its own server, never from a tab.
CORS_ORIGINS=

# Publish the OpenAPI document at /docs. Turn this off in production - an API
# description is a map of the attack surface.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Users microservice (internal TCP transport - do not expose publicly)
# ---------------------------------------------------------------------------
USERS_SERVICE_HOST=127.0.0.1
USERS_SERVICE_PORT=4001

# ---------------------------------------------------------------------------
# Upstream user directory
#   local  - serve the reqres.in dataset from memory (default, no key needed)
#   reqres - call https://reqres.in/api/users for real
# ---------------------------------------------------------------------------
USERS_SOURCE=local
REQRES_BASE_URL=https://reqres.in/api
REQRES_PER_PAGE=6
REQRES_MAX_PAGES=50

# Required only when USERS_SOURCE=reqres. Free key from https://app.reqres.in/api-keys
REQRES_API_KEY=
